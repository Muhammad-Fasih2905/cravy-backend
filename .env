# Postgres in production. For quick local dev you can use: sqlite:///./cravy.db
DATABASE_URL=sqlite:///./cravy.db
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=8f3a9c2e7b1d4f6a0e5c8b2d9f7a3e1c6b4d8f2a9e7c5b3d1f8a6e4c2b9d7f5a
ADMIN_EMAIL=cravy@gmail.com
ADMIN_PASSWORD=cravy@12345
# Uploads (product images are public under /media/products, receipts are private)
UPLOAD_DIR=./uploads
# Optional email notifications. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# Easypaisa account customers pay to (default is already 03143404938)
EASYPAISA_NUMBER=03143404938
EASYPAISA_ACCOUNT_NAME=
# Shop location (delivery distance is measured from here). Already the default; override only if the shop moves.
SHOP_LATITUDE=24.911012
SHOP_LONGITUDE=67.105612
