# Postgres in production. For quick local dev you can use: sqlite:///./cravy.db
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cravy
CORS_ORIGINS=http://localhost:3000
# Admin login (created by `python -m app.seed`). Use a long random SECRET_KEY: openssl rand -hex 32
SECRET_KEY=change-me
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Uploads (product images are public under /media/products, receipts are private)
UPLOAD_DIR=./uploads
# Optional email notifications. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# Easypaisa account customers pay to (default is already 03143404938)
EASYPAISA_NUMBER=03143404938
EASYPAISA_ACCOUNT_NAME=
